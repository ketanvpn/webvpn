# ============================================================
# .env.example — Template konfigurasi (TANPA secret nyata)
# Salin jadi .env, isi value asli. JANGAN commit .env asli.
# Dipakai oleh api-server (baca process.env) & drizzle push.
# Runtime PM2 pakai ecosystem.config.cjs (duplikat value ini).
# ============================================================

# ── Wajib ───────────────────────────────────────────────────
# String koneksi PostgreSQL. Ganti PASSWORD dan nama DB sesuai server.
DATABASE_URL=postgresql://ketantech:GANTI_PASSWORD@localhost:5432/ketantech_db

# Secret untuk JWT. Minimal 32 karakter. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=GANTI_DENGAN_STRING_ACAK_PANJANG_MIN_32

NODE_ENV=production
# Port internal API (jangan dibuka ke internet, lewat Nginx 80/443)
PORT=5000

# Origin frontend yg boleh akses API. Set ke domain Anda.
# Contoh: https://vpn.ketanx.com  atau  http://68.183.230.134
CORS_ORIGIN=https://DOMAIN_ATAU_IP

# IP proxy yg dipercaya (Nginx di server sama). Jangan set 'true'.
TRUSTED_PROXIES=127.0.0.1,::1

# Cloudflare Turnstile (anti-bot login). Ambil dari Cloudflare Dashboard.
TURNSTILE_SECRET_KEY=ISI_DARI_CLOUDFLARE
# false = paling aman (login ditolak jika Turnstile gagal verifikasi)
TURNSTILE_FAIL_OPEN=false

# ── Opsional ─────────────────────────────────────────────────
# Level log: debug | info | warn | error
LOG_LEVEL=info

# Nama app PM2 (default ketantech-api)
PM2_APP_NAME=ketantech-api

# URL publik situs (untuk link di notifikasi Telegram)
SITE_URL=https://DOMAIN_ATAU_IP

# Hanya set 'true' untuk debugging panel VPN via HTTP (RISIKO MITM). Biarkan kosong.
# ALLOW_INSECURE_PANEL_TLS=true

# Key shared untuk BotVPN memanggil API (header X-Bot-API-Key)
BOT_API_KEY=

# ── Integrasi provider VPN (opsional) ────────────────────────
NADIAVPN_API_BASE_URL=
NADIAVPN_API_TOKEN=

# ── Backup (opsional) ────────────────────────────────────────
# Direktori simpan file backup. Default: ./backups (persisten, tetap setelah restart)
# BACKUP_DIR=/var/www/ketantech-vpn/backups
