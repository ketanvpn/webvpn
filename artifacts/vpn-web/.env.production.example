# .env.production.example — Template env frontend (Vite build-time)
# Salin jadi .env.production, isi value asli. JANGAN commit file asli.
# Ambil dari Cloudflare Dashboard > Turnstile (bagian Site Key).
VITE_TURNSTILE_SITE_KEY=ISI_SITE_KEY_DARI_CLOUDFLARE

# VITE_API_URL opsional. Biarkan kosong untuk pakai origin yg sama (relatif /api).
# VITE_API_URL=https://vpn.ketanx.com
